<configuration>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>gsmart_general.log</file>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="RECONNECTION_LOG" class="ch.qos.logback.core.FileAppender">
        <file>reconnection.log</file> <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern> </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>

    <logger name="ReconnectionLogger" level="INFO" additivity="false">
        <appender-ref ref="RECONNECTION_LOG" />
    </logger>

</configuration>